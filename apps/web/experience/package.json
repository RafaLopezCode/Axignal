{
  "name": "axignal-experience",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3810",
    "build": "npm run check:repertoire && npm run check:styles && npm run check:seo && next build && node tools/localize-static-html-lang.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3810",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:admin-http": "node --test tools/check-admin-transport.mjs",
    "check:seo": "tsx --test tests/acquisition.test.ts tests/self-presence.test.ts tests/site-icons.test.ts tests/public-seo.test.ts",
    "check:i18n": "node tools/locale-inventory.mjs --check",
    "check:styles": "node tools/surface-styles.mjs --check",
    "check:repertoire": "tsx tools/landing-lab-repertoire.ts --check"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.130",
    "@gsap/react": "2.1.2",
    "ai": "7.0.127",
    "gsap": "3.15.0",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "postcss": "8.5.23"
  }
}
