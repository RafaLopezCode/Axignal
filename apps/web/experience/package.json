{
  "name": "axignal-experience",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3810",
    "build": "npm run check:seo && next build && node tools/localize-static-html-lang.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3810",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:seo": "tsx --test tests/acquisition.test.ts",
    "check:i18n": "node tools/locale-inventory.mjs --check"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.130",
    "ai": "7.0.127",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.51.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "tsx": "4.23.15"
  }
}
