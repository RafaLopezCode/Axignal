[Unit]
Description=AXIGNAL daily autonomous observation tick
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/srv/axignal/docker/current/deploy/production/run-observation-daily.sh

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/axignal/observation-runtime/scheduler.env
# Skip (rather than report a successful tick) while intentionally disabled.
ExecCondition=/bin/sh -c 'test "$$AXIGNAL_OBSERVATION_RUNTIME_ENABLED" = true'
ExecStart=/bin/sh /srv/axignal/docker/current/deploy/production/run-observation-daily.sh
# The hard lifetime is below the runtime's one-hour fenced lease.
TimeoutStartSec=30min
ExecStopPost=-/bin/sh -c 'if /usr/bin/docker container inspect axignal-prod-observation-daily >/dev/null 2>&1; then /usr/bin/docker stop --time 15 axignal-prod-observation-daily >/dev/null; fi'
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/axignal/runtime /run /var/run
