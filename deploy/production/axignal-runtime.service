[Unit]
Description=AXIGNAL Governed Runtime
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/axignal/runtime/current
EnvironmentFile=/etc/axignal/runtime.env
ExecStart=/usr/bin/python3 -m tools.runtime
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/axignal/runtime/current
ReadWritePaths=/var/lib/axignal/runtime
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
