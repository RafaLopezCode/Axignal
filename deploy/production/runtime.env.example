# No secrets belong in this file. Deployment replaces AXIGNAL_CODE_SHA exactly.
AXIGNAL_ENV=production
AXIGNAL_BIND_HOST=127.0.0.1
AXIGNAL_PORT=18181
AXIGNAL_CODE_SHA=REPLACE_WITH_EXACT_MAIN_SHA
AXIGNAL_DATA_DIR=/var/lib/axignal/runtime
AXIGNAL_WEB_ROOT=/srv/axignal/runtime/current/apps/web
AXIGNAL_FIRST_PROOF_ALLOWED_HOST=axignal.com
AXIGNAL_ACQUISITION_EVENTS_ENABLED=false
AXIGNAL_WEEKLY_BRIEF_REQUESTS_ENABLED=false
# Keep weekly brief requests disabled until legal identity/privacy notices are production-ready.

# PB12 research canary is opt-in via the Compose profile "research-canary".
# These values are non-secret controls. The OpenAI key is mounted as a
# Compose secret from AXIGNAL_OPENAI_API_KEY_FILE and is never placed in the
# container environment or committed here.
# AXIGNAL_RESEARCH_CANARY_SUBJECT_ID=org:approved-canary
# AXIGNAL_RESEARCH_CANARY_MAX_TICKS=12
# AXIGNAL_RESEARCH_CANARY_INTERVAL_SECONDS=300
# AXIGNAL_OPENAI_API_KEY_FILE=/etc/axignal/secrets/openai_api_key

# AO-10 Stripe ingress stays disabled until a real sandbox E2E passes.
# Non-secret live merchant identity is confirmed as acct_1TybkH8feyjV8Pem, but do not
# enable these values in production until deployment is explicitly authorized.
# AXIGNAL_STRIPE_ACCOUNT_ID=acct_1TybkH8feyjV8Pem
# AXIGNAL_STRIPE_BASE_PRICE_REF=REPLACE_WITH_APPROVED_STRIPE_PRICE_ID
# AXIGNAL_STRIPE_ADDITIONAL_XEED_PRICE_REF=REPLACE_WITH_APPROVED_STRIPE_PRICE_ID
# AXIGNAL_STRIPE_WEBHOOK_SIGNING_SECRET=<inject from deployment secret storage; never commit>
